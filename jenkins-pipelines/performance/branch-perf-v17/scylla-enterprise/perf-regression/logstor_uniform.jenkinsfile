#!groovy

// trick from https://github.com/jenkinsci/workflow-cps-global-lib-plugin/pull/43
def lib = library identifier: 'sct@snapshot', retriever: legacySCM(scm)

// Build parameters this job MUST be given. perfRegressionParallelPipeline hardcodes the
// defaults for all of them rather than reading them from pipelineParams, so they cannot
// be set from here - enter them in "Build with Parameters":
//
//   scylla_ami_id        an aarch64 AMI built from mlitvk/scylladb logstor_perf
//   byo_scylla_repo      empty
//   byo_scylla_branch    empty
//   scylla_version       empty
//   byo_build_both_arch  unticked
//   billing_project      LogStor
//
// HAND IT A PREBUILT AMI, DO NOT LET IT RUN THE BYO BUILD. The byo path cannot select an
// ARM image, for two independent reasons - the runbook's traps 10 and 11 - and it fails
// quietly: the detection error is caught and the run continues with x86 packages on a
// Graviton cluster. Build the pair out of band (/scylla-master/byo/byo_build_tests_dtest
// with BUILD_ARM=true) and pass the arm64 one here. byoScylladb.groovy:5-8 then returns
// before either bug can fire, and provisionResources.groovy:90 / runSctTest.groovy:128
// export SCT_AMI_ID_DB_SCYLLA from the parameter. The byo pair must stay empty: with
// both set, byoScylladb.groovy:10 hard-errors on the conflict. Empty scylla_version is
// not optional either - sct_config.py:3179 rejects it together with ami_id_db_scylla.
// Once traps 10 and 11 are fixed, byo_scylla_repo=https://github.com/mlitvk/scylladb
// with byo_scylla_branch=logstor_perf and an empty scylla_ami_id is how this is meant to
// work.
//
// The build source is not optional here. The direct write path exists only on the byo
// branch: master carries no logstor_direct_writes_enabled, no
// logstor_direct_write_memory_in_mb, no logstor_format_on_startup and no
// logstor_compaction_trigger_threshold, and scylla logs an unknown scylla.yaml key as a
// warning and starts anyway - so a run handed scylla_version=master:latest silently
// ignores everything enable_logstor.yaml pins and measures the separator path instead.
// That is what every earlier logstor-uniform build did, and why they died a few minutes
// into the measured step with "logstor - Error writing mutation: condition_variable
// timed out": the offered rate was ~1.7x the ceiling of the path they were actually on.
//
// byo_build_both_arch does not rescue the arch detection and is not needed here.
// byoScylladb.groovy:61 captures testNeedArm before the override, so line 136 still
// installs the x86 BYO_AMI_ID; the flag only adds a second x86 build this job never
// touches. It is irrelevant altogether on the AMI route above.

perfRegressionParallelPipeline(
    backend: "aws",
    region: "us-east-1",
    provision_type: 'on_demand',
    test_name: "performance_regression_gradual_grow_throughput.PerformanceRegressionPredefinedStepsTest",
    test_config: '''["test-cases/performance/perf-regression-predefined-throughput-steps.yaml", "configurations/disable_kms.yaml", "configurations/disable_speculative_retry.yaml", "configurations/performance/latency-decorator-error-thresholds-steps-ent-tablets.yaml", "configurations/performance/latency-decorator-error-thresholds-logstor-tablets.yaml", "configurations/performance/enable_logstor.yaml", "configurations/performance/logstor_uniform_queries.yaml"]''',
    sub_tests: ["test_mixed_gradual_increase_load"],
)
